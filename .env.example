# LeadHunter Studio — Environment Variable Template
# Copy to `.env` for local development (never commit `.env` or real secrets).

# --- Required Authentication ---
# Required in all environments; API returns HTTP 503 (fail-closed) when unset.
LEADHUNTER_API_KEY=replace-with-strong-random-api-key

# --- Runtime Environment ---
# Set to `production` in production deployments (disables Flask debug unconditionally).
LEADHUNTER_ENV=development
FLASK_DEBUG=false
PORT=5000

# --- Redis & RQ Background Worker ---
# Required in production for asynchronous /api/jobs execution and multi-worker rate limiting.
# Leave blank locally to use in-memory fallback rate limiting and synchronous /api/scrape.
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE_NAME=leadhunter
REQUIRE_ACTIVE_WORKER=false
JOB_TIMEOUT_SECONDS=900
JOB_RESULT_TTL_SECONDS=3600
JOB_FAILURE_TTL_SECONDS=3600
JOB_DEDUP_TTL_SECONDS=900
JOB_MAX_RETRIES=2

# --- Rate Limiting & Reverse Proxy ---
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_CLOSED=false
# Number of trusted reverse proxy hops (0 for direct/local; 1 for Render/Nginx).
TRUSTED_PROXY_HOPS=0
MAX_CONTENT_LENGTH=5242880

# --- Browser & Gunicorn Concurrency ---
BROWSER_MAX_CONCURRENCY=1
BROWSER_ACQUIRE_TIMEOUT_SECONDS=30
CHROMIUM_NO_SANDBOX=false
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30

# --- Logging ---
LOG_LEVEL=INFO
# `json` (default in production) or `text` (default locally)
LOG_FORMAT=text

# --- Optional External Integrations ---
# Optional: enables Google PageSpeed Insights & Core Web Vitals scoring.
GOOGLE_PAGESPEED_API_KEY=
